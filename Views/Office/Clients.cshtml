@model REAgency.Models.ObjectPageViewModel
@using REAgencyEnum
@{
    ViewData["Title"] = "Clients";
}
<div class="containerForOffice">
  

    <div class="panel-column">

        <nav style="width: 100%; margin-top: 60px; padding-left:20px;">
            <ul class="custom-ul">
                
                <li class="custom-li">
                    <a class="custom-a" href="#">Додати...</a>
                   
                    <ul class="dropdown">
                        <li><a class="custom-a" asp-action="Create" asp-route-selEstate="Flat">Квартиру</a></li>
                        <li><a class="custom-a" asp-action="Create" asp-route-selEstate="House">Будинок</a></li>
                        <li><a class="custom-a" asp-action="Create" asp-route-selEstate="Room">Кімната</a></li>
                        <li><a class="custom-a" asp-action="Create" asp-route-selEstate="Stead">Ділянку</a></li>
                        <li><a class="custom-a" asp-action="Create" asp-route-selEstate="Office">Офіс</a></li>
                        <li><a class="custom-a" asp-action="Create" asp-route-selEstate="Premis">Приміщення</a></li>
                        <li><a class="custom-a" asp-action="Create" asp-route-selEstate="Garage">Гараж</a></li>
                        <li><a class="custom-a" asp-action="Create" asp-route-selEstate="Parking">Парко-місце</a></li>
                        <li><a class="custom-a" asp-action="Create" asp-route-selEstate="Storage">Склад</a></li>
                    </ul>
                </li>
                <li class="custom-li">
                    <a class="custom-a" >Клієнти...</a>
                    <ul class="dropdown">
                        <li><a class="custom-a" asp-action="Clients" asp-controller="Office">Переглянути всіх клієнтів</a></li>
                       
                    </ul>
                </li>
                @if (Context.Session.GetString("IsAdmin") == "True")
                {
                    <li class="custom-li">
                        <a class="custom-a" >Співробітники...</a>
                        <ul class="dropdown">
                            <li><a class="custom-a" asp-action="Create" asp-controller="Employee">Додати співробітника</a></li>
                            <li><a class="custom-a" asp-action="Index" asp-controller="Employee">Переглянути всіх співробітників</a></li>

                        </ul>
                    </li>
                   @*  <li class="custom-li">
                        <a class="custom-a">Типи об'єктів...</a>
                        <ul class="dropdown">
                            <li><a class="custom-a">Додати тип</a></li>
                            <li><a class="custom-a" >Переглянути всіх типи</a></li>

                        </ul>
                    </li>
                    <li class="custom-li">
                        <a class="custom-a" >Валюта...</a>
                        <ul class="dropdown">
                            <li><a class="custom-a" >Додати валюту</a></li>
                            <li><a class="custom-a">Переглянути всі валюти</a></li>

                        </ul>
                    </li> *@
                    <li class="custom-li">
                        <a class="custom-a" >Область...</a>
                        <ul class="dropdown">
                            <li><a class="custom-a" asp-action="Create" asp-controller="Region">Додати область</a></li>
                            <li><a class="custom-a" asp-action="Index" asp-controller="Region">Переглянути всі області</a></li>

                        </ul>
                    </li>
                    <li class="custom-li">
                        <a class="custom-a" >Регіон...</a>
                        <ul class="dropdown">
                            <li><a class="custom-a" asp-action="Create" asp-controller="District">Додати регіон</a></li>
                            <li><a class="custom-a" asp-action="Index" asp-controller="District">Переглянути всі регіони</a></li>

                        </ul>
                    </li>
                    <li class="custom-li">
                        <a class="custom-a" >Населений пункт...</a>
                        <ul class="dropdown">
                            <li><a class="custom-a" asp-action="Create" asp-controller="Locality">Додати населений пункт</a></li>
                            <li><a class="custom-a" asp-action="Index" asp-controller="Locality">Переглянути всі населений пункти</a></li>

                        </ul>
                    </li>
                    
                }

            </ul>
        </nav>

    </div>

    
    <div class="objects">
        <div style="margin-top: 40px;flex-direction: column;align-items: center;justify-content: center;">
            
           
           
            <div >
                @if (Model.Objects.Any())
                {
                    @foreach (var item in Model.Objects)
                    {
                        <div class="item">
                            <div>
                                <div class="price-style">
                                    <p> @Html.DisplayFor(modelItem => item.clientName)</p>
                                    <p> @Html.DisplayFor(modelItem => item.clientPhone)</p>
                                    @if (item.typeObject == ObjectType.Flat.ToString())
                                    {
                                        <p>Квартира</p>
                                    }
                                    else if (item.typeObject == ObjectType.Office.ToString())
                                    {
                                        <p>Офіс</p>
                                    }
                                    else if (item.typeObject == ObjectType.Garage.ToString())
                                    {
                                        <p>Гараж</p>
                                    }
                                    else if (item.typeObject == ObjectType.House.ToString())
                                    {
                                        <p>Дім</p>
                                    }
                                    else if (item.typeObject == ObjectType.Stead.ToString())
                                    {
                                        <p>Ділянка</p>
                                    }
                                    else if (item.typeObject == ObjectType.Room.ToString())
                                    {
                                        <p>Кімната</p>
                                    }
                                    else if (item.typeObject == ObjectType.Parking.ToString())
                                    {
                                        <p>Парко-місце</p>
                                    }
                                    else if (item.typeObject == ObjectType.Storage.ToString())
                                    {
                                        <p>Склад</p>
                                    }
                                    else if (item.typeObject == ObjectType.Premis.ToString())
                                    {
                                        <p>Приміщення</p>
                                    }
                                    else
                                    {
                                        <p>@Html.DisplayFor(modelItem => item.typeObject)</p>
                                    }
                                    <p>@Html.DisplayFor(modelItem => item.Price)</p>
                                    @* <p>@Html.DisplayFor(modelItem => item.Area) @Html.DisplayFor(modelItem => item.unitAreaName)</p>
                                    <p>@Html.DisplayFor(modelItem => item.Price) @Html.DisplayFor(modelItem => item.currencyName)</p> *@
                                    <p>@Html.DisplayFor(modelItem => item.localityName)</p>
                                    <p>@Html.DisplayFor(modelItem => item.employeeId)</p>

                                    @* <a asp-controller="Office" asp-action="Update" asp-route-id="@item.Id" asp-route-typeObject="@item.typeObject" class="update-button">Редагувати</a> *@
                                    @* <a asp-controller="Office" asp-action="Detailse" asp-route-id="@item.Id" asp-route-typeObject="@item.typeObject" class="toList-button" style="padding: 5px">Деталі</a> *@
                                    

                                </div>
                            </div>                            
                        </div>                    
                        
                    }
                }
                else
                {
                    <h2>На жаль за Вашим запитом нічого не знайдено</h2>
                }
            </div>

            @if(Context.Session.GetString("IsAdmin") == "True")
            {
                <page-link page-model="Model.PageViewModel" page-action="SearchForAdmin"></page-link>
            }
            else
            {
                <page-link page-model="Model.PageViewModel" page-action="Search"></page-link>
            }
            
            

        </div>

    </div>
</div>



