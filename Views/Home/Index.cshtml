@model HomePageViewModel

@{
    ViewData["Title"] = "Home Page";
}
<div class="main-div" style="background-color: #B4DAF5">
    <h1 style="margin-top: 100px">Агентство нерухомості</h1>
   
    <div >
        <form asp-action="Search" method="post" class="search">
             <div class="custom-select-wrapper">
            <div class="custom-select" id="operationSelect">
                <span></span>
            </div>
            <div class="custom-options" id="operationOptions">
            </div>

            <select id="operationNativeSelect" asp-items="ViewBag.OperatrionsList as SelectList" style="display:none;" name="operationTypeId">
                    <option value="0">Операція</option>
            </select>
        </div>

        <div class="custom-select-wrapper">
            <div class="custom-select" id="objectSelect">
                <span></span>
            </div>
            <div class="custom-options" id="objectOptions">
            </div>

            <select id="objectNativeSelect" asp-items="ViewBag.EsateTypesList as SelectList" style="display:none;" name="estateTypeId">
                    <option value="0">Всі об'єкти</option>
                    <option value="1">Квартира</option>
                    <option value="2">Гараж</option>
                    <option value="3">Дім</option>
                    <option value="4">Офіс</option>
                    <option value="5">Парко-місце</option>
                    <option value="6">Приміщення</option>
                    <option value="7">Кімната</option>
                    <option value="8">Ділянка</option>
                    <option value="9">Склад</option>
            </select>
        </div>


        <div class="custom-select-wrapper">
            <div class="custom-select" id="localitySelect">
                <span></span>
            </div>
            <div class="custom-options" id="localityOptions">
            </div>

            <select id="localityNativeSelect" asp-items="ViewBag.LocalitiesList as SelectList" style="display:none;" name="localityId">
                <option value="0">Місто</option>
            </select>
        </div>

        <div class="search-buttons-div">
            <a id="toggleButton"> <img src="https://img.icons8.com/?size=100&id=LALXQcDwgx8U&format=png&color=000000" width="35px" height="35px" /></a>
            <input type="submit" class="search-button" style="margin-left: 60px" value="Знайти"></input>
        </div>

        <div>
            <div id="filtration">
                <div class="filtration-container">
                    <div class="area-for-items">
                        <label>Площа</label>

                        <div class="range">
                            <input type="text" placeholder="Min" class="filtration-input" name="minArea"/>
                            <input type="text" placeholder="Max" class="filtration-input" name="maxArea"/>

                        </div>

                    </div>
                    <div class="area-for-items">
                        <label>Ціна</label>

                        <div class="range">
                            <input type="text" placeholder="Min" class="filtration-input" name="minPrice"/>
                            <input type="text" placeholder="Max" class="filtration-input" name="maxPrice"/>
                        </div>
                    </div>
                </div>
            </div>
        </div>
        </form>
       
    </div>

    
    <div class="catalog">
        <div class ="catalog-header">
            <h2>КАТАЛОГ ОБ'ЄКТІВ</h2>
            <p >
                Знайдіть саме те, що вам потрібно...
            </p>
        </div>
          
        <div class="catalog-items">

            <form asp-action="ShowObjectsByType" method="post" class="catalog-item vertical">
                <a onclick="this.closest('form').submit();" style="cursor:pointer;">
                    <img src="~/img/flats.webp" alt="Квартири">
                    <div class="catalog-item-text">
                        <h3>КВАРТИРИ</h3>
                    </div>
                    <input type="hidden" name="objectType" value="Flat" />
                </a>
            </form>
             <form asp-action="ShowObjectsByType" method="post" class="catalog-item">
                <a onclick="this.closest('form').submit();" style="cursor:pointer;">
                    <img src="~/img/house.jpeg" alt="Будинки">
                    <div class="catalog-item-text">
                        <h3>БУДИНКИ</h3>
                    </div>
                    <input type="hidden" name="objectType" value="House" />
                </a>
            </form>
             <form asp-action="ShowObjectsByType" method="post" class="catalog-item">
                <a onclick="this.closest('form').submit();" style="cursor:pointer;">
                    <img src="~/img/garage.jpg" alt="Гаражі">
                    <div class="catalog-item-text">
                        <h3>ГАРАЖІ</h3>
                    </div>
                    <input type="hidden" name="objectType" value="Garage" />
                </a>
            </form>

             <form asp-action="ShowObjectsByType" method="post" class="catalog-item">
                <a onclick="this.closest('form').submit();" style="cursor:pointer;">
                    <img src="~/img/plot.jpeg" alt="Ділянки">
                    <div class="catalog-item-text">
                        <h3>ДІЛЯНКИ</h3>
                    </div>
                    <input type="hidden" name="objectType" value="Stead" />
                </a>
            </form>
            <form asp-action="ShowObjectsByType" method="post" class="catalog-item">
                <a onclick="this.closest('form').submit();" style="cursor:pointer;">
                    <img src="~/img/office.webp" alt="Ділянки">
                    <div class="catalog-item-text">
                        <h3>ОФІСИ</h3>
                    </div>
                    <input type="hidden" name="objectType" value="Office" />
                </a>
            </form>
        </div>
    </div>
    <div id="aboutUs">
        <div id="aboutLine1">
            <div class="divDarkBlue">
                <h3 class="about_h3">Висока якість послуг</h3>
                <p class="about_p">Наша мета - задовольнити Вашу потребу в повній мірі та отримати рекомендації.</p>
            </div>
            <div class="divBlue">
                <h3 class="about_h3">Актуальна база нерухомості</h3>
                <p class="about_p">
                    Ми завжди намагаємося тримати базу даних в актуальному стані, постійно оновлюємо
                    та додаємо нові об'єкти. Якщо Ви власник, теж можете це зробити.
                </p>
            </div>
            <div class="divDarkBlue">
                <h3 class="about_h3">Надійність</h3>
                <p class="about_p">
                    Фахівці агенції нерухомості "Городок" зроблять усе необхідне аби убезпечити
                    Вас від будь-яких ризиків. Нас цікавлять надійні та тривалі відносини з клієнтом.
                </p>
            </div>
            <div class="divBlue">
                <h3 class="about_h3">Конфіденційність</h3>
                <p class="about_p">Ми поважаємо Ваш особистий простір.</p>
            </div>
        </div>
        <div id="aboutLine2">
            <div class="divBlue">
                <h3 class="about_h3">Виправдана вартість винагороди</h3>
                <p class="about_p">
                    Ваша перевага при співпраці з нами полягає у врегульованих тарифах на послуги.
                    Ви уникнете неприємних несподіванок та дорогих послуг "чорних брокерів".
                </p>
            </div>
            <div class="divDarkBlue">
                <h3 class="about_h3">Нас рекомендують</h3>
                <p class="about_p">
                    Найвищим показником якості роботи агенції нерухомості "Городок" є рекомендації.
                    Ми завжди раді новим знайомствам та пишаємось тим, що нас рекомендують людям.
                </p>
            </div>
            <div class="divBlue">
                <h3 class="about_h3">Індивідуальний підхід</h3>
                <p class="about_p">
                    Фахівці агенції максимально врахують усі Ваші побажання до об'єкту
                    нерухомості чи послуги.
                </p>
            </div>
            <div class="divDarkBlue">
                <h3 class="about_h3">Благодійність</h3>
                <p class="about_p">Співпрацюючи з нами Ви гарантовано допоможете іншим!</p>
            </div>
        </div>
    </div>
    <div class="form-block">
        <h2>Індивідуальний підбір</h2>
        <p>
            Надішліть заявку на індивідуальний підбір нерухомості, щоб наш менеджер якнайшвидше з вами зв'язався!
        </p>
        <form class="application-form" asp-action="SendApplication">
            <div asp-validation-summary="ModelOnly" class="text-danger"></div>

            <div class="inputBlock" style="margin-top: 20px; ">
                
                <input class="allInput" asp-for="appName" type="text" placeholder="Повне ім'я" />
                <span class="validation" asp-validation-for="appName"></span>
            </div>
          
            <div class="inputBlock" style="margin-top: 20px">
                
                <input class="allInput" asp-for="appPhone" type="text" placeholder="Телефон"/>
                <span class="validation" asp-validation-for="appPhone" ></span>
            </div>
            <div class="form-group" style="margin-top: 20px">
                <input type="submit" value="Відправити" class="submitButton"  />
            </div>
        </form>

    </div>

</div>


    
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script>

        let success = '@TempData["SuccessMessage"]';
        if (success == "true") {
            Swal.fire({
                position: "center",
                icon: "success",
                title: "Заявка успішно надіслана",
                showConfirmButton: false,
                timer: 1500
            });
        
        }
       
    </script>
}
   
<div>

    <div id="cookie_note">
        <p>
            Ми використовуємо файли cookies для покращення роботи сайту. Залишаючись на нашому сайті, ви погоджуєтесь з умовами
            використання файлів cookie. Щоб ознайомитися з нашими Положеннями про конфіденційність та використання
            файлів cookie, <a href="#" target="_blank">натисніть тут</a>.
        </p>
        <button class="button cookie_accept btn btn-primary btn-sm">Я згоден</button>
    </div>
</div>


<script>
    function setCookie(name, value, days) {
        let expires = "";
        if (days) {
            let date = new Date();
            date.setTime(date.getTime() + (days * 24 * 60 * 60 * 20));
            expires = "; expires=" + date.toUTCString();
        }
        document.cookie = name + "=" + (value || "") + expires + "; path=/";
    }

    function getCookie(name) {
        let matches = document.cookie.match(new RegExp("(?:^|; )" + name.replace(/([\.$?*|{}\(\)\[\]\\\/\+^])/g, '\\$1') + "=([^;]*)"));
        return matches ? decodeURIComponent(matches[1]) : undefined;
    }


    function checkCookies() {
        let cookieNote = document.getElementById('cookie_note');
        let cookieBtnAccept = cookieNote.querySelector('.cookie_accept');

        // Если куки cookies_policy нет или она просрочена, то показываем уведомление
        if (!getCookie('cookies_policy_Agency')) {
            cookieNote.classList.add('show');
        }

        // При клике на кнопку устанавливаем куку cookies_policy на 10 дней
        cookieBtnAccept.addEventListener('click', function () {
            setCookie('cookies_policy_Agency', 'true', 7);
            cookieNote.classList.remove('show');
        });
    }

    checkCookies();

</script>
